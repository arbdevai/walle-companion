<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Top Half: Cozmo / Vector Animated Expressive Robot Eyes -->
        <com.walle.companion.ui.WalleEyeView
            android:id="@+id/walleEyeView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <!-- Middle: AI Speech Subtitle (appears when speaking/listening) -->
        <TextView
            android:id="@+id/tvSpeechSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/walle_iris_cyan"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />

        <!-- Bottom Half: Prominent High-Visibility Digital Clock -->
        <com.walle.companion.ui.DigitalClockView
            android:id="@+id/digitalClockView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <!-- Bottom Micro HUD: Status & Quick Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#555555"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:text="@string/prompt_tap_to_talk" />

            <!-- Palette (Change Eye & Clock Color) -->
            <TextView
                android:id="@+id/btnChangeColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#777777"
                android:textSize="11sp"
                android:padding="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="WARNA" />

            <!-- Clock Style Switcher -->
            <TextView
                android:id="@+id/btnChangeClockStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#777777"
                android:textSize="11sp"
                android:padding="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="MODEL JAM" />

            <!-- Chat / Voice Input Trigger -->
            <TextView
                android:id="@+id/btnQuickChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/walle_iris_cyan"
                android:textSize="11sp"
                android:padding="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="BICARA" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
